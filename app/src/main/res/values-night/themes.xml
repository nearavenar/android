<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CocktailApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (Es el que se utiliza mas en los componentes de la aplicaion). -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>

        <!-- color On Primary color. (Se utiliza cuando se escribe encima del color principal) -->
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color. (es para mostrar informacion destacada dentro de la aplicaion) -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>

        <!-- color On Primary color. (Se utiliza cuando se escribe encima del color secundario) -->
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <item name="android:textViewStyle">@style/textViewStyle</item>
    </style>

    <style name="textViewStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">24dp</item>
        <item name="android:background">?attr/colorSecondary</item>
    </style>

</resources>