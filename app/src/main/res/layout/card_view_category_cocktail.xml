<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:cardMaxElevation="10dp"
    app:cardPreventCornerOverlap="true">
    <!-- style="@style/localTextViewStyle" -->
    <!-- app:cardUseCompatPadding="true" -->

    <RelativeLayout
        android:id="@+id/cv_adapter_cocktail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ImageVIew to display our Course Image -->
        <ImageView
            android:id="@+id/img_cocktail"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_margin="10dp"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_cocktail_mojito_foreground" />

        <!-- Text View to display Course Name -->
        <TextView
            android:id="@+id/tv_cocktail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_toEndOf="@id/img_cocktail"
            android:text="Category"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Text VIew to display Course Rating -->
        <!-- Image used in present in drawable folder -->
        <TextView
            android:id="@+id/tv_cocktail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_cocktail_title"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_toEndOf="@id/img_cocktail"
            android:drawablePadding="2dp"
            android:textColor="@color/black"
            android:text="Contails" />
        <!-- android:textAppearance="@style/localTextViewStyle" -->

    </RelativeLayout>
</androidx.cardview.widget.CardView>